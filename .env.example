# Copy this file to .env and fill in real values. Never commit .env.
# The names below are the single source of truth for configuration keys.
# See docs/18-production-plan.md for what each one means in production.

# Spring profile: dev, test or prod
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL through the SESSION pooler (not the transaction pooler)
DB_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>

# Supabase Storage. The service key is server-side only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=learning-resources

# AI integration. Use "mock" until a provider is approved (see docs/decisions/0005).
AI_ENABLED=true
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT_PER_USER=30
AI_MAX_OUTPUT_TOKENS=1200

# First administrator, created once when no admin exists
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=<choose-a-strong-temporary-password>

# Password given to synthetic accounts by the dev seed (dev profile only)
DEV_SEED_PASSWORD=<choose-a-local-password>

# Academic rules (confirm with the college, see open decisions in docs/01-project-charter.md)
ATTENDANCE_REQUIRED_PERCENT=75
