# Copy this file to .env and fill in real values. Never commit .env.
# The names below are the single source of truth for configuration keys.
# See docs/18-production-plan.md for what each one means in production.

# Spring profile: dev, test or prod
SPRING_PROFILES_ACTIVE=dev

# Official student email domain. Students log in as <roll number>@<this domain>.
# Host name only, no "@". Use a reserved example domain for development and tests,
# and the confirmed official domain in production. Never hardcode it anywhere else.
STUDENT_EMAIL_DOMAIN=university.example

# Supabase PostgreSQL through the SESSION pooler (not the transaction pooler)
DB_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres

# Runtime role: used by the running application. Owns nothing. Never "postgres".
DB_USERNAME=<cc_app-user-name>
DB_PASSWORD=<cc_app-password>

# Migration role: used only by Flyway at startup. Owns schema "app".
DB_MIGRATION_USERNAME=<cc_migrator-user-name>
DB_MIGRATION_PASSWORD=<cc_migrator-password>

# Supabase Storage. The service key is server-side only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=learning-resources

# AI integration. Use "mock" until a provider is approved (see docs/decisions/0005).
AI_ENABLED=true
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT_PER_USER=30
# Daily ceiling across ALL users. Provisional default; set it with the AI budget.
AI_DAILY_LIMIT_GLOBAL=500
AI_MAX_OUTPUT_TOKENS=1200

# First administrator, created once when no admin exists.
# Use an administrator address, not a student one, and a strong password (never a roll number).
ADMIN_BOOTSTRAP_EMAIL=<administrator-email>
ADMIN_BOOTSTRAP_PASSWORD=<choose-a-strong-temporary-password>

# Synthetic data seeder. Runs automatically in the dev profile.
# In any other profile it runs only when DEMO_SEED_ENABLED=true (set for one start, then remove).
# Seeded students are provisioned like any other: their first password is their roll number
# and must be changed at first login.
DEMO_SEED_ENABLED=false

# Academic rules (confirm with the college, see open decisions in docs/01-project-charter.md)
ATTENDANCE_REQUIRED_PERCENT=75

# Notes: documents that may be attached besides PDF, as a comma list of extensions
# (doc,docx,xls,xlsx,ppt,pptx,txt,csv,md,zip). Leave empty unless the storage bucket allows them.
NOTES_EXTRA_FILE_TYPES=
